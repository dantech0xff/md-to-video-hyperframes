{
  "compilerOptions": {
    "target": "ES2023",
    "lib": ["ES2023"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "esModuleInterop": true,
    "isolatedModules": true,
    "noEmit": true,
    "types": ["node", "vite/client"]
  },
  "include": ["electron.vite.config.ts", "vitest.config.ts", "src/main/**/*", "src/engine/**/*", "src/preload/**/*", "src/shared/**/*", "scripts/**/*.ts"]
}
