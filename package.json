{
  "name": "md-to-video-hyperframes",
  "version": "2.0.0",
  "description": "Programming-lesson video engine for Dan Tech: notes or Markdown into narrated, word-synced lesson videos in 16:9 (YouTube, with chapters) and 9:16 (Shorts), rendered with HyperFrames + GSAP",
  "main": "src/cli.ts",
  "directories": {
    "doc": "docs"
  },
  "type": "module",
  "scripts": {
    "test": "vitest run --passWithNoTests",
    "test:watch": "vitest",
    "pipeline": "tsx src/cli.ts",
    "lesson": "tsx src/lesson/cli.ts",
    "lesson:storyboard": "tsx src/lesson/cli.ts --storyboard",
    "lesson:frames": "tsx src/lesson/cli.ts --frames",
    "examples:check": "tsx scripts/check-examples.ts",
    "rerender": "tsx rerender.ts",
    "typecheck": "tsc --noEmit",
    "build": "tsc",
    "sfx:download": "tsx scripts/download-sfx.ts",
    "sfx:filter": "tsx scripts/filter-sfx.ts",
    "audio:catalog": "tsx scripts/audio-catalog.ts",
    "sounds:starter": "tsx scripts/make-starter-sounds.ts",
    "voice:clone": "tsx scripts/voice-clone.ts",
    "fonts:fetch": "tsx scripts/fetch-fonts.ts"
  },
  "keywords": [
    "video",
    "lesson",
    "education",
    "programming",
    "markdown",
    "hyperframes",
    "gsap",
    "tts",
    "vietnamese",
    "youtube",
    "shorts",
    "kotlin",
    "android",
    "clean-architecture",
    "mobile",
    "claude-code",
    "elevenlabs",
    "lucylab"
  ],
  "author": "Dan Tech (https://dantech.academy)",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dantech0xff/md-to-video-hyperframes.git"
  },
  "homepage": "https://github.com/dantech0xff/md-to-video-hyperframes#readme",
  "dependencies": {
    "axios": "^1.15.2",
    "dotenv": "^17.4.2",
    "edge-tts-universal": "^1.4.0",
    "gsap": "^3.14.2",
    "hyperframes": "^0.4.34",
    "lucide-static": "^1.48.0",
    "p-limit": "^7.3.0",
    "shiki": "^3.23.0",
    "simple-icons": "^16.32.0",
    "three": "^0.184.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/node": "^25.6.0",
    "@vitest/coverage-v8": "^4.1.5",
    "nock": "^14.0.13",
    "puppeteer-core": "^24.43.1",
    "tsx": "^4.21.0",
    "typescript": "^6.0.3",
    "vitest": "^4.1.5"
  }
}
