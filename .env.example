# ════════════════════════════════════════════════════════════════════════════
# md-to-video-hyperframes — Environment Configuration
# ════════════════════════════════════════════════════════════════════════════
# Copy this file to .env.local and fill in your real API keys.
# .env.local is gitignored — never commit real keys.
#
# Lesson videos (npm run lesson) work out of the box with the free voice
# (Edge TTS, no key). Keys are only needed for a cloned instructor voice
# (ElevenLabs / LucyLab) or for the legacy news pipeline (npm run pipeline)
# with a paid provider. Lesson settings: see "Lesson videos" below.

# ── TTS Provider (legacy news pipeline) ─────────────────────────────────────
# Voice provider for `npm run pipeline`. Lessons ignore it and pick their voice
# with VOICE_PROFILE (see "Lesson videos"), but the keys of the provider named
# here are still checked at startup: keep edge-tts unless you filled them in.
# Choose ONE: "edge-tts", "lucylab", "elevenlabs" or "vbee"
# - edge-tts   : Microsoft Edge online TTS (FREE, no API key required, supports VN & SRT)
# - lucylab    : Vietnamese voice cloning (recommended for VN content), free SRT
# - elevenlabs : multilingual, more voice options, higher quality but pricier
# - vbee       : Vietnamese TTS (https://vbee.vn), async polling model
TTS_PROVIDER=edge-tts

# ════════════════════════════════════════════════════════════════════════════
# OPTION 1: Edge TTS (Free - Microsoft Edge TTS via edge-tts-universal)
# ════════════════════════════════════════════════════════════════════════════
# No API key required. Also the lesson "free" voice.
# Vietnamese voices available:
# - vi-VN-HoaiMyNeural (Female)
# - vi-VN-NamMinhNeural (Male  - default)
EDGE_TTS_VOICE=vi-VN-NamMinhNeural
EDGE_TTS_RATE=+0%
EDGE_TTS_PITCH=+0Hz
EDGE_TTS_VOLUME=+0%

# ════════════════════════════════════════════════════════════════════════════
# OPTION 2: LucyLab.io  (https://lucylab.io)
# ════════════════════════════════════════════════════════════════════════════
# Required when TTS_PROVIDER=lucylab, or for a lesson clone voice with CLONE_PROVIDER=lucylab
VIETNAMESE_API_KEY=sk_live_xxxxxxxxxxxxxxxxxxxx
VIETNAMESE_VOICEID=22charvoiceiduuidhere

# Optional overrides
LUCYLAB_ENDPOINT=https://api.lucylab.io/json-rpc
LUCYLAB_POLL_INTERVAL_MS=2000
LUCYLAB_POLL_TIMEOUT_MS=120000

# ════════════════════════════════════════════════════════════════════════════
# OPTION 3: ElevenLabs  (https://elevenlabs.io)
# ════════════════════════════════════════════════════════════════════════════
# Required when TTS_PROVIDER=elevenlabs, or for a lesson clone voice with CLONE_PROVIDER=elevenlabs
# Get API key at:  https://elevenlabs.io/app/settings/api-keys
# Browse voices at: https://elevenlabs.io/app/voice-library
ELEVENLABS_API_KEY=sk_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
ELEVENLABS_VOICE_ID=EXAVITQu4vr4xnSDxMaL

# Optional model override (default: eleven_v3).
# Vietnamese needs eleven_v3 (most expressive) or eleven_flash_v2_5 (fastest, cheapest).
# eleven_multilingual_v2 does NOT support Vietnamese.
ELEVENLABS_MODEL_ID=eleven_v3
ELEVENLABS_ENDPOINT=https://api.elevenlabs.io/v1

# ════════════════════════════════════════════════════════════════════════════
# OPTION 4: Vbee  (https://vbee.vn)
# ════════════════════════════════════════════════════════════════════════════
# Required when TTS_PROVIDER=vbee
# Register at https://vbee.vn to get your app_id and access_token.
VBEE_APP_ID=your_app_id
VBEE_ACCESS_TOKEN=your_access_token

# Optional overrides
VBEE_VOICE_CODE=n_hanoi_male_protrainer_education_vc
VBEE_SPEED_RATE=1.0
VBEE_ENDPOINT=https://vbee.vn/api/v1
VBEE_POLL_INTERVAL_MS=2000
VBEE_POLL_TIMEOUT_MS=60000

# ════════════════════════════════════════════════════════════════════════════
# Lesson videos — Dan Tech (npm run lesson)
# ════════════════════════════════════════════════════════════════════════════
# Voice used when a lesson script does not set "voice": { "profile": … }
# - free  : Edge TTS (EDGE_TTS_VOICE above) + tech-vi pronunciation lexicon, no key needed
# - clone : the instructor's cloned voice, from CLONE_PROVIDER below
VOICE_PROFILE=free

# Where the cloned voice lives:
# - elevenlabs : `npm run voice:clone -- --name "…" samples/*.mp3 --save` writes ELEVENLABS_VOICE_ID
# - lucylab    : clone the voice on lucylab.io, then set VIETNAMESE_API_KEY + VIETNAMESE_VOICEID
CLONE_PROVIDER=elevenlabs

# Sound library folders (default: assets/sfx and assets/music). Files are picked by name,
# see assets/sfx/README.md. Point these at a shared library outside the repo if you like.
# SFX_DIR=/path/to/sfx
# MUSIC_DIR=/path/to/music

# Chrome for storyboard/preview captures (auto-detected; set it if detection fails)
# CHROME_PATH=/usr/bin/google-chrome

# ════════════════════════════════════════════════════════════════════════════
# TikTok follow card (legacy news pipeline outro)
# ════════════════════════════════════════════════════════════════════════════
# Customize the TikTok-style profile card that appears at the end of every news video.
# Lessons take their name, handle and CTA from assets/brand/<id>/brand.json instead.
# All fields optional — defaults work out of the box.
TIKTOK_DISPLAY_NAME=Dan Tech
TIKTOK_HANDLE=@dantech0xff
TIKTOK_FOLLOWERS=dantech.academy

# Optional: URL to your real TikTok avatar image (jpg/png, square, ~256x256+).
# If not set, uses the bundled default avatar at assets/avatar.{jpg,png,webp}.
# You can also replace that file directly with your own image.
# TIKTOK_AVATAR_URL=https://example.com/your-avatar.jpg

# ── Pipeline tuning ─────────────────────────────────────────────────────────
# TTS_CONCURRENCY: Concurrency limit for TTS generation (e.g. 1-3)
TTS_CONCURRENCY=1

# ════════════════════════════════════════════════════════════════════════════
# Visual theme (legacy news pipeline)
# ════════════════════════════════════════════════════════════════════════════
# Lessons use style packs instead ("style" in the script, or --style).
# Choose ONE: "dark-neon" (default) or "light-pro"
# - dark-neon : navy/cyan/purple, glow effects — original look
# - light-pro : white/slate/indigo, clean corporate look, no neon/grain
# Each channel/brand can pin its own value in a separate .env if desired.
VIDEO_THEME=dark-neon
